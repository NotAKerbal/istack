{
  "mcpServers": {
    "linux-computer-use": {
      "command": "node",
      "args": ["./src/server.mjs"],
      "startup_timeout_sec": 20,
      "tool_timeout_sec": 130,
      "env_vars": ["DISPLAY", "WAYLAND_DISPLAY", "XDG_SESSION_TYPE", "XDG_CURRENT_DESKTOP", "XDG_RUNTIME_DIR", "DBUS_SESSION_BUS_ADDRESS", "XDG_STATE_HOME"]
    }
  }
}
