{
  "name": "linux-computer-use",
  "version": "0.2.0",
  "description": "Persistent native GNOME desktop control over MCP, with XDG portal fallback and AT-SPI",
  "bin": { "linux-computer-use": "src/server.mjs" },
  "engines": { "node": ">=20" },
  "files": ["src/", "native/*.py", "scripts/", "skills/", ".codex-plugin/", ".mcp.json", "plugin.json", "mcp.json", "README.md", "LICENSE"],
  "scripts": {
    "start": "node src/server.mjs",
    "doctor": "/usr/bin/python3 native/worker.py --doctor",
    "test": "node --test tests/*.test.mjs && /usr/bin/python3 -m unittest discover -s tests -p 'test_*.py'",
    "test:desktop": "node scripts/desktop-smoke.mjs",
    "stop": "node scripts/control.mjs stop",
    "resume": "node scripts/control.mjs resume",
    "setup:codex": "node scripts/setup-codex.mjs",
    "verify:codex": "node scripts/verify-codex.mjs",
    "setup:service": "node scripts/setup-service.mjs",
    "verify:service": "node scripts/verify-service.mjs"
  },
  "keywords": [],
  "license": "MIT",
  "type": "module",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "zod": "^4.6.7"
  }
}
